---
/**
 * 404 — "Sheet No. 404": a blank stencil that never got tattooed, and the
 * way back to every page that exists. Built to dist/404.html, which the
 * Express server sends for unknown routes. Noindex.
 */
import Base from '../layouts/Base.astro';
import shop from '../data/shop.json';
import { STYLE_PAGES, INFO_PAGES } from '../lib/seo';

const { shop: s } = shop;
const title = 'Page Not Found | Chris Valencia Tattoo';
const description =
  'That address is not on the sheet. Find the portfolio, the style pages, the FAQ, and the booking form for Chris Valencia at Powerline Tattoo in Cranston, RI.';
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base title={title} description={description} canonicalPath="/404/" noindex bodyClass="page-404">
  <section class="section container nf">
    <div class="nf__grid">
      <div class="nf__copy">
        <p class="eyebrow"><span class="sheet-no">Sheet No. 404</span> Not found</p>
        <h1>This page isn't on the sheet.</h1>
        <p class="answer">
          Nothing lives at this address. It may have moved, or the link had a typo, or it's one of those ideas that
          only ever existed in the sketchbook. Everything that does exist is one click away, and the booking form
          is the page that matters most.
        </p>
        <div class="cluster">
          <a class="btn btn--primary" href="/book/">Request a booking</a>
          <a class="btn" href="/">Back to the front</a>
        </div>

        <nav class="nf__nav" aria-label="Pages that exist">
          <div class="nf__col">
            <p class="nf__h">Styles</p>
            <ul class="nf__list" role="list">
              {
                STYLE_PAGES.map((l, i) => (
                  <li>
                    <a href={l.path}><span class="sheet-no" aria-hidden="true">{pad(i + 1)}</span> {l.name}</a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="nf__col">
            <p class="nf__h">Info</p>
            <ul class="nf__list" role="list">
              {
                INFO_PAGES.map((l) => (
                  <li>
                    <a href={l.path}>{l.name}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </nav>
        <p class="small muted">
          Looking for a specific piece? Every tattoo in the <a href="/portfolio/">portfolio</a> has a number, and
          the lightbox opens straight to it.
        </p>
      </div>

      <figure class="nf__frame frame reg-marks" aria-hidden="true">
        <div class="nf__stencil">
          <svg viewBox="0 0 200 250" width="200" height="250" focusable="false">
            <rect x="12" y="12" width="176" height="226" rx="6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="6 5"></rect>
            <circle cx="100" cy="112" r="46" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="6 5"></circle>
            <path d="M100 40v144M28 112h144" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="3 4"></path>
            <circle cx="100" cy="112" r="4" fill="currentColor"></circle>
          </svg>
          <span class="nf__404">404</span>
        </div>
        <figcaption>
          <span class="sheet-no">No. 404</span>
          <span>Blank stencil · never tattooed</span>
        </figcaption>
      </figure>
    </div>
    <p class="nf__shop small muted">
      {s.name}, {s.streetAddress}, {s.addressLocality}, {s.addressRegion} {s.postalCode} ·
      <a href={`tel:${s.telephone}`}>{s.telephoneDisplay}</a>
    </p>
  </section>
</Base>

<style>
  .nf__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .nf__copy {
    display: grid;
    gap: var(--space-m);
    max-width: 60rem;
  }

  .nf__copy h1 {
    max-width: 12ch;
  }

  @media (min-width: 880px) {
    .nf__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    }
  }

  .nf__nav {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-xs);
    max-width: 36rem;
  }

  @media (min-width: 480px) {
    .nf__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .nf__h {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
    padding-bottom: 0.5rem;
    margin-bottom: 0.3rem;
    border-bottom: 1px solid var(--rule-2);
  }

  .nf__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nf__list a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--tap);
    text-decoration-color: transparent;
  }

  .nf__list a:hover {
    text-decoration-color: currentColor;
  }

  .nf__frame {
    width: min(100%, 22rem);
    justify-self: center;
    color: var(--ink);
  }

  .nf__stencil {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    background: var(--paper);
    border: 1px solid var(--rule);
    color: var(--ink-2);
  }

  .nf__stencil svg {
    width: 70%;
    height: auto;
  }

  .nf__404 {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(4rem, 14vw, 7rem);
    letter-spacing: -0.05em;
    color: var(--rule-2);
  }

  @supports (-webkit-text-stroke: 1px black) {
    .nf__404 {
      color: transparent;
      -webkit-text-stroke: 2px var(--accent);
    }
  }

  .nf__shop {
    margin-top: var(--space-xl);
    padding-top: var(--space-s);
    border-top: 1px solid var(--rule);
  }
</style>
