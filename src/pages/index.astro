<script>
  // Hero slideshow: cross-fades through the featured pieces every 5 s.
  // Off under prefers-reduced-motion (the tabs still work), pausable with a
  // real button, paused while the tab is hidden or focus is inside the sheet.
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (hero) {
    const slides = Array.from(hero.querySelectorAll<HTMLElement>('[data-hero-slide]'));
    const tabs = Array.from(hero.querySelectorAll<HTMLButtonElement>('[data-hero-tab]'));
    const pauseBtn = hero.querySelector<HTMLButtonElement>('[data-hero-pause]');
    const capEl = hero.querySelector<HTMLElement>('[data-hero-cap]');
    const noEl = hero.querySelector<HTMLElement>('[data-hero-no]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const INTERVAL = 5000;

    let index = 0;
    let timer: number | undefined;
    let auto = !reduce.matches;

    const paint = () => {
      if (!pauseBtn) return;
      pauseBtn.setAttribute('aria-pressed', String(!auto));
      pauseBtn.setAttribute('aria-label', auto ? 'Pause slideshow' : 'Play slideshow');
    };

    const show = (n: number) => {
      if (!slides.length) return;
      const next = (n + slides.length) % slides.length;
      if (next === index && slides[next].classList.contains('is-active')) return;
      slides.forEach((slide, k) => {
        slide.classList.remove('was-active');
        if (k === index) slide.classList.add('was-active');
        slide.classList.toggle('is-active', k === next);
        slide.setAttribute('aria-hidden', k === next ? 'false' : 'true');
      });
      index = next;
      tabs.forEach((tab, k) => tab.setAttribute('aria-pressed', String(k === index)));
      const current = slides[index];
      if (capEl) capEl.textContent = current.dataset.caption || '';
      if (noEl) noEl.textContent = current.dataset.no ? `No. ${current.dataset.no}` : '';
    };

    const stop = () => {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    };

    const start = () => {
      stop();
      if (!auto || document.hidden || slides.length < 2) return;
      timer = window.setInterval(() => show(index + 1), INTERVAL);
    };

    // The other slides stay hidden until the lead image has painted, so the
    // first piece wins the bandwidth and the layout never shifts.
    const arm = () => {
      slides.forEach((slide) => {
        slide.hidden = false;
      });
      start();
    };
    const leadImg = slides[0]?.querySelector('img');
    if (leadImg && !leadImg.complete) {
      leadImg.addEventListener('load', arm, { once: true });
      leadImg.addEventListener('error', arm, { once: true });
    } else {
      arm();
    }

    tabs.forEach((tab, k) => {
      tab.addEventListener('click', (e) => {
        show(k);
        // A pointer click restarts the clock; a keyboard activation leaves
        // the show paused while focus stays inside the sheet.
        if (e.detail > 0) start();
      });
    });

    pauseBtn?.addEventListener('click', () => {
      auto = !auto;
      paint();
      if (auto) start();
      else stop();
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    reduce.addEventListener('change', () => {
      auto = !reduce.matches;
      paint();
      if (auto) start();
      else stop();
    });

    hero.addEventListener('focusin', stop);
    hero.addEventListener('focusout', (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (!next || !hero.contains(next)) start();
    });

    paint();
  }
</script>
