---
/**
 * VideoEmbed: a click-to-load YouTube (nocookie) facade drawn as a framed
 * title card: a local poster, a vermilion play mark and a caption legend.
 * Nothing from YouTube loads until the visitor presses play, which keeps the
 * page fast and cookie-free. Without JavaScript the iframe is embedded
 * directly (lazy) and a plain "Watch on YouTube" link sits in the caption.
 *
 * Props
 *   src             embed URL (default: shop.json artist.video, youtube-nocookie)
 *   title           the video's real title; accessible name + iframe title
 *   poster          { src, width, height } local image behind the play mark
 *   posterPosition  object-position for the poster crop (default "center")
 *   sheetNo         legend label (default "Video")
 *   caption         short line under the frame
 *   id              unique per page
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import shop from '../data/shop.json';

export interface Poster {
  src: string;
  width: number;
  height: number;
}

export interface Props {
  src?: string;
  title?: string;
  poster?: Poster;
  posterPosition?: string;
  sheetNo?: string;
  caption?: string;
  id?: string;
}

const {
  src = shop.artist.video,
  title = 'Tattoo Artist Chris Valencia Intro',
  poster = { src: shop.artist.headshot, width: 800, height: 600 },
  posterPosition = 'center',
  sheetNo = 'Video',
  caption = 'Hosted on YouTube. Nothing loads until you press play.',
  id = 'video',
} = Astro.props;

const videoId = src.match(/embed\/([\w-]+)/)?.[1] ?? '';
const watchUrl = videoId ? `https://www.youtube.com/watch?v=${videoId}` : src;
const embedSrc = `${src}${src.includes('?') ? '&' : '?'}autoplay=1&rel=0`;

/* WebP poster variants when the file lives in public/images. */
const sources = import.meta.glob<ImageMetadata>('/public/images/**/*.{jpg,jpeg,png}', {
  eager: true,
  import: 'default',
});
const meta = sources[`/public${poster.src}`];
const posterSet = meta
  ? await getImage({ src: meta, widths: [480, 720, 960], format: 'webp', quality: 78 })
  : null;
const POSTER_SIZES = '(min-width: 1000px) 600px, 92vw';
---

<figure class="video reg-marks" id={id} data-video data-src={embedSrc} data-title={title}>
  <p class="video__legend">
    <span class="sheet-no">{sheetNo}</span>
    <span class="video__legend-title">{title}</span>
  </p>

  <div class="video__stage" data-video-stage>
    <picture class="video__poster-wrap">
      {posterSet && <source type="image/webp" srcset={posterSet.srcSet.attribute} sizes={POSTER_SIZES} />}
      <img
        class="video__poster"
        src={poster.src}
        width={poster.width}
        height={poster.height}
        alt=""
        loading="lazy"
        decoding="async"
        style={`object-position:${posterPosition}`}
      />
    </picture>
    <span class="video__screen" aria-hidden="true"></span>

    <button type="button" class="video__play js-only" data-video-play aria-label={`Play video: ${title}`}>
      <span class="video__ring">
        <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" focusable="false">
          <path d="M8 5.5v13l11-6.5z" fill="currentColor"></path>
        </svg>
      </span>
      <span class="video__label">Play</span>
    </button>

    <noscript>
      <iframe
        class="video__frame"
        src={src}
        title={title}
        loading="lazy"
        allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </noscript>
  </div>

  <figcaption class="video__cap">
    <span>{caption}</span>
    <a href={watchUrl} rel="noopener">Watch on YouTube</a>
  </figcaption>
</figure>

<style is:global>
  .video {
    position: relative;
    margin: 0;
    padding: clamp(8px, 1.5vw, 14px);
    background: var(--paper-3);
    border: 1px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
    --mark-inset: -9px;
  }

  .video__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35em 0.75em;
    padding: 0 0 0.6em;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .video__legend-title {
    font-weight: 600;
    color: var(--ink);
  }

  .video__stage {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--paper-2);
    border: 1px solid var(--ink);
  }

  .video__poster-wrap,
  .video__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .video__poster {
    object-fit: cover;
    filter: saturate(0.9);
    transition: transform 0.6s var(--ease-out);
  }

  .video:hover .video__poster {
    transform: scale(1.02);
  }

  /* Dot screen over the poster: a printed still, not a thumbnail. */
  .video__screen {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(circle, rgba(20, 18, 16, 0.55) 0.7px, transparent 1.1px);
    background-size: 5px 5px;
    opacity: 0.35;
    mix-blend-mode: multiply;
  }

  .video__play {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    color: var(--on-accent);
    cursor: pointer;
  }

  .video__ring {
    display: grid;
    place-items: center;
    width: clamp(64px, 12vw, 88px);
    height: clamp(64px, 12vw, 88px);
    padding-left: 4px;
    border-radius: 50%;
    color: var(--on-accent);
    background: var(--accent-fill);
    box-shadow:
      0 0 0 4px var(--paper-3),
      0 0 0 5.5px var(--ink);
    transition: transform 0.2s var(--ease-out);
  }

  .video__play:hover .video__ring,
  .video__play:focus-visible .video__ring {
    transform: scale(1.06);
  }

  .video__play:focus-visible {
    outline-offset: -6px;
  }

  .video__label {
    position: absolute;
    left: 12px;
    bottom: 12px;
    padding: 0.4em 0.7em;
    font: 700 var(--step--1) / 1 var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--paper-3);
    border: 1px solid var(--ink);
  }

  .video__frame {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
  }

  .video.is-playing .video__poster-wrap,
  .video.is-playing .video__screen {
    display: none;
  }

  .video__cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.3em 1em;
    padding-top: 0.7em;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .video__cap a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-style: normal;
    font-family: var(--font-body);
    font-weight: 600;
  }

  @media (max-width: 479.98px) {
    .video {
      box-shadow: 4px 4px 0 var(--ink);
    }
  }
</style>

<script>
  const figures = document.querySelectorAll<HTMLElement>('[data-video]');

  figures.forEach((fig) => {
    const button = fig.querySelector<HTMLButtonElement>('[data-video-play]');
    const stage = fig.querySelector<HTMLElement>('[data-video-stage]');
    if (!button || !stage) return;

    button.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.className = 'video__frame';
        iframe.src = fig.dataset.src || '';
        iframe.title = fig.dataset.title || 'Video';
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.setAttribute('allowfullscreen', '');
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        stage.appendChild(iframe);
        fig.classList.add('is-playing');
        button.hidden = true;
        iframe.focus();
      },
      { once: true },
    );
  });
</script>
