---
/**
 * Cta: the booking ask drawn as an appointment card with a tear-off stub.
 * Left, the card: eyebrow, heading, one paragraph and the list of what the
 * form asks for. Right, perforated off the card, the stub: the booking
 * button, the shop phone and the appointment-only note. No rates or deposit
 * amounts anywhere; the deposit is "confirmed when you book".
 *
 * Usage:
 *   <Cta />
 *   <Cta sheetNo="No. 08" heading="Ready when you are." body="…" />
 */
import shop from '../data/shop.json';

export interface Props {
  sheetNo?: string;
  eyebrow?: string;
  heading?: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  fields?: string[];
  id?: string;
}

const { shop: s } = shop;

const {
  sheetNo = 'No. 08',
  eyebrow = 'Appointment card',
  heading = 'Ready when you are.',
  body = 'Send the idea, the placement and any references through the booking form. Chris replies by email to talk it through, and a deposit holds your date once the details are set; the amount is confirmed when you book.',
  primaryLabel = 'Request a booking',
  primaryHref = '/book/',
  fields = [
    'Your idea, in a sentence or two',
    'Placement and rough size',
    'Reference images',
    'Budget range',
    'Timing',
  ],
  id = 'cta',
} = Astro.props;

const dayRange = `${s.days[0].slice(0, 3)}–${s.days[s.days.length - 1].slice(0, 3)}`;
---

<section class="cta reveal" id={id} aria-labelledby={`${id}-h`}>
  <div class="container">
    <div class="cta__card">
      <div class="cta__main">
        <p class="eyebrow"><span class="sheet-no">{sheetNo}</span> {eyebrow}</p>
        <h2 id={`${id}-h`} class="cta__h">{heading}</h2>
        <p class="cta__body">{body}</p>
        <ul class="cta__fields" role="list" aria-label="What the form asks for">
          {
            fields.map((field) => (
              <li class="cta__field">
                <span class="cta__field-text">{field}</span>
                <span class="cta__leader" aria-hidden="true" />
                <span class="cta__box" aria-hidden="true" />
              </li>
            ))
          }
        </ul>
      </div>

      <div class="cta__stub">
        <p class="cta__stub-label" aria-hidden="true">
          {s.name} · {s.addressLocality}, {s.addressRegion}
        </p>
        <a class="btn btn--primary btn--block" href={primaryHref}>{primaryLabel}</a>
        <a class="btn btn--block" href={`tel:${s.telephone}`}>Call {s.telephoneDisplay}</a>
        <p class="cta__note">
          <span class="stamp">{s.hoursNote}</span>
          <span class="cta__days">{dayRange}</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--space-xl);
  }

  .cta__card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background: var(--paper-3);
    border: 1px solid var(--ink);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--accent);
    transform: rotate(-0.4deg);
  }

  .cta__main {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .cta__h {
    font-size: var(--step-4);
    max-width: 14ch;
  }

  .cta__body {
    max-width: 52ch;
    color: var(--ink-2);
  }

  .cta__fields {
    display: grid;
    gap: 0.45rem;
    margin: var(--space-xs) 0 0;
    padding: 0;
    max-width: 34rem;
    list-style: none;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-0);
  }

  .cta__field {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .cta__leader {
    flex: 1 1 auto;
    min-width: 2rem;
    border-bottom: 1.5px dotted var(--rule-2);
    transform: translateY(-0.3em);
  }

  .cta__box {
    flex: 0 0 auto;
    width: 0.9em;
    height: 0.9em;
    border: 1.5px solid var(--ink);
    transform: translateY(0.1em) rotate(-3deg);
  }

  /* The stub: perforated off the card, with notches on the outer edge. */
  .cta__stub {
    position: relative;
    display: grid;
    gap: var(--space-s);
    align-content: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--paper-2);
    border-top: 2px dashed var(--rule-2);
  }

  .cta__stub::before,
  .cta__stub::after {
    content: '';
    position: absolute;
    top: -10px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--ink);
  }

  .cta__stub::before {
    left: -10px;
  }

  .cta__stub::after {
    right: -10px;
  }

  .cta__stub-label {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .cta__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    margin-top: var(--space-xs);
  }

  .cta__days {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 600;
    font-size: var(--step-1);
  }

  @media (min-width: 760px) {
    .cta__card {
      grid-template-columns: minmax(0, 1.6fr) minmax(17rem, 1fr);
    }

    .cta__stub {
      border-top: 0;
      border-left: 2px dashed var(--rule-2);
    }

    .cta__stub::before,
    .cta__stub::after {
      left: -10px;
      right: auto;
    }

    .cta__stub::before {
      top: -10px;
    }

    .cta__stub::after {
      top: auto;
      bottom: -10px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .cta__card {
      transition: transform 0.3s var(--ease-out);
    }

    .cta__card:hover {
      transform: rotate(0deg);
    }
  }
</style>
